# ─────────────────────────────────────────────────────────────────────────────
# Kryptonews: environment variables
# Local: copy to .env (git-ignored). Coolify: set them in the Environment tab;
# every SERVICE_PASSWORD_* value is generated automatically there.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (used for cookies, canonical URLs, sitemap, OAuth).
PUBLIC_URL=http://localhost:3000

# Database secrets (Coolify generates them).
SERVICE_PASSWORD_MARIADB=change-me-database-password
SERVICE_PASSWORD_MARIADBROOT=change-me-root-password

# Session signing secret, 32+ characters (Coolify generates it).
SERVICE_PASSWORD_64_JWT=change-me-a-long-random-string-of-at-least-32-characters

# Editors (admins) sign in with Google, restricted to ADMIN_EMAILS (below).
# Optional fallback: a password editor account created on first start.
ADMIN_USERNAME=editor
ADMIN_EMAIL=admin@example.com
SERVICE_PASSWORD_ADMIN=change-me-admin-password
# Comma-separated Google addresses allowed into the editor's desk. Any other
# Google account is refused (no account is created).
ADMIN_EMAILS=

# Google OAuth client for the editor's entrance. Authorized redirect URI to
# register in the Google Cloud console: ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: free CoinGecko "Demo" key for higher rate limits (works without).
COINGECKO_API_KEY=

# Contact address: legal pages, "Feedback or a bug?" emails and forgotten
# passwords (otherwise a link to the contact form on mbonnici.fr is shown).
CONTACT_EMAIL=

# How long headlines are kept before automatic deletion (days). ~200 headlines/day,
# roughly 1 MB per 1,000 headlines: 45 days is ~15 MB, 365 days stays under ~100 MB.
ARTICLE_RETENTION_DAYS=45

# Access requests (readers never create accounts themselves: editors approve each
# request on the desk). Global caps, all IPs together, beyond which the form pauses:
SIGNUP_MAX_PER_HOUR=30
SIGNUP_MAX_PER_DAY=200
# Pending queue size, and days before an unanswered request is deleted.
MAX_PENDING_REQUESTS=100
PENDING_REQUEST_DAYS=30
# Hard ceiling on reader accounts.
MAX_ACCOUNTS=5000
# Anti-robot proof-of-work difficulty (8-24 bits; 16 = about 1 s on a phone).
SIGNUP_POW_BITS=16

# Use Cloudflare's CF-Connecting-IP header for rate limiting (site behind Cloudflare).
TRUST_CLOUDFLARE=true
